<Window x:Class="KanbanApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KanbanApp"
        mc:Ignorable="d"
        Title="Kanban" Height="600" Width="1000"
        Background="#1E1E1E">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- To Do -->
        <Border Grid.Column="0" Margin="4" Background="#2D2D30" CornerRadius="6" Padding="8">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="To Do" FontSize="16" FontWeight="Bold"
                           Foreground="White" Margin="4,0,4,8" />
                <StackPanel>
                    <Border Background="#3C3C3F" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                        <TextBlock Text="Sample task" Foreground="White" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- In Progress -->
        <Border Grid.Column="1" Margin="4" Background="#2D2D30" CornerRadius="6" Padding="8">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="In Progress" FontSize="16" FontWeight="Bold"
                           Foreground="White" Margin="4,0,4,8" />
                <StackPanel />
            </DockPanel>
        </Border>

        <!-- Done -->
        <Border Grid.Column="2" Margin="4" Background="#2D2D30" CornerRadius="6" Padding="8">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="Done" FontSize="16" FontWeight="Bold"
                           Foreground="White" Margin="4,0,4,8" />
                <StackPanel />
            </DockPanel>
        </Border>

        <!-- Parked -->
        <Border Grid.Column="3" Margin="4" Background="#2D2D30" CornerRadius="6" Padding="8">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="Parked" FontSize="16" FontWeight="Bold"
                           Foreground="White" Margin="4,0,4,8" />
                <StackPanel />
            </DockPanel>
        </Border>
    </Grid>
</Window>
