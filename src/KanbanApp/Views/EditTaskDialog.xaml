<Window x:Class="KanbanApp.Views.EditTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Task"
        Width="340" Height="160"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E">
    <StackPanel Margin="16">
        <TextBlock Text="Title" Foreground="#CCCCCC" FontSize="11" Margin="0,0,0,4" />
        <TextBox x:Name="TitleBox" Background="#3C3C3F" Foreground="White" BorderThickness="0"
                 Padding="6" CaretBrush="White" Margin="0,0,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" Padding="10,4" />
            <Button Content="Save" Click="Save_Click" Padding="10,4" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
