<UserControl x:Class="KanbanApp.Views.MentionTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <TextBox x:Name="InnerTextBox"
                 Background="#3C3C3F" Foreground="White" BorderThickness="0"
                 Padding="6" CaretBrush="White"
                 TextChanged="InnerTextBox_TextChanged"
                 PreviewKeyDown="InnerTextBox_PreviewKeyDown" />
        <Popup x:Name="SuggestionPopup" PlacementTarget="{Binding ElementName=InnerTextBox}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="#2D2D30" BorderBrush="#555555" BorderThickness="1" CornerRadius="4" MaxHeight="140" MinWidth="140">
                <ListBox x:Name="SuggestionList" Background="Transparent" Foreground="White" BorderThickness="0"
                         PreviewMouseLeftButtonUp="SuggestionList_PreviewMouseLeftButtonUp" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
