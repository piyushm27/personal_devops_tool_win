<Window x:Class="KanbanApp.Views.TaskDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KanbanApp.Views"
        Title="Task Details"
        Width="480" Height="580"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Title" Foreground="#CCCCCC" FontSize="11" Margin="0,0,0,4" />
        <views:MentionTextBox x:Name="TitleBox" Grid.Row="1" Margin="0,0,0,16" />

        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                <TextBlock Text="Original Estimate (h)" Foreground="#CCCCCC" FontSize="11" Margin="0,0,0,4" />
                <TextBox x:Name="OriginalEstimateBox" Background="#3C3C3F" Foreground="White" BorderThickness="0" Padding="6" CaretBrush="White" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                <TextBlock Text="Completed (h)" Foreground="#CCCCCC" FontSize="11" Margin="0,0,0,4" />
                <TextBox x:Name="CompletedWorkBox" Background="#3C3C3F" Foreground="White" BorderThickness="0" Padding="6" CaretBrush="White" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="4,0,0,0">
                <TextBlock Text="Remaining (h)" Foreground="#CCCCCC" FontSize="11" Margin="0,0,0,4" />
                <TextBox x:Name="RemainingWorkBox" Background="#3C3C3F" Foreground="White" BorderThickness="0" Padding="6" CaretBrush="White" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3" Text="Comments" Foreground="#CCCCCC" FontSize="11" Margin="0,0,0,4" />

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
            <ItemsControl x:Name="CommentsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2D2D30" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="{Binding Text}" Foreground="White" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:g}'}" Foreground="#888888" FontSize="10" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="5" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <views:MentionTextBox x:Name="NewCommentBox" Grid.Column="0" />
            <Button Grid.Column="1" Content="Add Comment" Click="AddComment_Click" Margin="8,0,0,0" Padding="10,4" />
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" Click="Close_Click" Padding="14,6" />
        </StackPanel>
    </Grid>
</Window>
