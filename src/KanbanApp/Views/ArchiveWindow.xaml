<Window x:Class="KanbanApp.Views.ArchiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:KanbanApp.Converters"
        Title="Archive"
        Width="420" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">
    <Window.Resources>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Archived tasks (auto-archived 7 days after completion)"
                   Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ArchiveList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#2D2D30" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="White" TextWrapping="Wrap" FontWeight="Bold" />
                                    <TextBlock Foreground="#888888" FontSize="10" Margin="0,4,0,0">
                                        <Run Text="Completed " /><Run Text="{Binding CompletedAt, StringFormat='{}{0:g}'}" />
                                        <Run Text=" · Archived " /><Run Text="{Binding ArchivedAt, StringFormat='{}{0:g}'}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="Nothing archived yet" Foreground="#999999" FontStyle="Italic"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"
                       Visibility="{Binding Items.Count, ElementName=ArchiveList, Converter={StaticResource CountToVisibilityConverter}}" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Click="Close_Click" Padding="14,6" />
        </StackPanel>
    </Grid>
</Window>
