<Window x:Class="KanbanApp.Views.WipLimitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WIP limit reached"
        Width="380" Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E">
    <StackPanel Margin="16">
        <TextBlock x:Name="HeaderText" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,12" FontSize="13" />

        <TextBlock Text="Pick a task to wrap up:" Foreground="#CCCCCC" FontSize="11" Margin="0,0,0,4" />
        <ListBox x:Name="TaskListBox" Height="90" Background="#2D2D30" Foreground="White" BorderThickness="0"
                 DisplayMemberPath="Title" Margin="0,0,0,12"
                 SelectionChanged="TaskListBox_SelectionChanged" />

        <TextBlock Text="If it's only partly done, edit what's left and send it back to To Do instead:" Foreground="#CCCCCC" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />
        <TextBox x:Name="EditTitleBox" Background="#3C3C3F" Foreground="White" BorderThickness="0"
                 Padding="6" CaretBrush="White" Margin="0,0,0,16" IsEnabled="False" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" Padding="10,4" />
            <Button x:Name="RequeueButton" Content="Update &amp; Send to To Do" Click="Requeue_Click" Margin="0,0,8,0" Padding="10,4" IsEnabled="False" />
            <Button x:Name="DoneButton" Content="Mark Done" Click="MarkDone_Click" Padding="10,4" IsEnabled="False" />
        </StackPanel>
    </StackPanel>
</Window>
